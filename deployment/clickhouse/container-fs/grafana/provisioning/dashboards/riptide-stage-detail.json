            "mode": "absolute",
            "steps": [
              {
                "color": "#2E9E63",
                "value": null
              },
              {
                "color": "#D9414B",
                "value": 0.001
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
