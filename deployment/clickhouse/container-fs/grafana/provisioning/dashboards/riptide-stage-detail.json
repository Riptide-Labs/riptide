          "expr": "sum by (component) (rate(label_replace({__name__=~\"parsers_.+_parserErrors\", job=\"riptide\", instance=~\"$instance\"}, \"component\", \"$1\", \"__name__\", \"parsers_(.+)_parserErrors\")[5m:]))",
