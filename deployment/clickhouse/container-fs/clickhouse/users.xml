<?xml version="1.0"?>
<clickhouse replace="true">
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>in_order</load_balancing>
            <log_queries>1</log_queries>
        </default>
        <!--
            Grafana's profile. readonly 2, not 1: the ClickHouse plugin sends max_execution_time with
            every query, and readonly 1 refuses any setting. Writes and DDL stay refused either way.
        -->
        <grafana>
            <readonly>2</readonly>
            <log_queries>1</log_queries>
        </grafana>
    </profiles>
    <users>
        <default>
            <!--
                Read from the environment so the compose file owns the value and this file carries
                no secret (#651). This user holds access_management, so without a password anyone
                who can reach 8123 has ClickHouse admin. Defaulted in compose.yml to keep the
                quickstart one command, with the ports published on loopback; set
                CLICKHOUSE_PASSWORD before publishing them wider.

                Narrowing <networks> instead was tried three times and does not work here: riptide
                authenticates as this user from a compose bridge address, as Grafana did until it
                got the grafana user below, so a loopback or fixed-CIDR rule breaks it (#636, #640,
                #641). Binding the published host ports is a different knob and does not affect it.
            -->
            <!--
                replace="1" is required, not decorative. Setting CLICKHOUSE_USER/CLICKHOUSE_PASSWORD
                makes the image entrypoint generate its own users.d/default-user.xml carrying a
                literal <password> (and access_management 0). Merging from_env onto an element that
                already has a value is refused outright: "Element <password> has value and does not
                have 'replace' attribute, can't process from_env substitution", and the server exits
                with CANNOT_LOAD_CONFIG rather than starting insecurely. This file is the source of
                truth for the user; the entrypoint's copy is overridden here, which relies on
                users.d being merged in name order (default-user.xml before users.xml).
            -->
            <password from_env="CLICKHOUSE_PASSWORD" replace="1"/>
            <profile>default</profile>
            <networks>
                <ip>::/0</ip>
            </networks>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
        <!--
            The identity Grafana's provisioned datasource reads with: SELECT on the riptide database
            and the catalog tables the dashboards' Database variable lists, nothing else. The datasource
            used to be default, a ClickHouse admin, so any Grafana editor's SQL in Explore ran as one.
            The database is named literally because a grant cannot read CLICKHOUSE_DB; it must match
            compose.yml, and make compose-smoke fails its read of riptide.flows through Grafana if not.
        -->
        <grafana>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>
            <profile>grafana</profile>
            <networks>
                <ip>::/0</ip>
            </networks>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON riptide.*</query>
                <query>GRANT SELECT ON system.databases</query>
                <query>GRANT SELECT ON system.tables</query>
                <query>GRANT SELECT ON system.columns</query>
            </grants>
        </grafana>
    </users>
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
